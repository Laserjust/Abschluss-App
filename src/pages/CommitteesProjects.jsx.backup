        { option: 'Transport', votes: 8 }
      ]
    }
  ];

  // Initialize data
  useEffect(() => {
    const initializeData = () => {
      if (hasYearData()) {
        const savedCommittees = dataIsolationService.getData('committees') || [];
        const savedProjects = dataIsolationService.getData('projects') || [];
        const savedSurveys = dataIsolationService.getData('surveys') || [];
        
        setCommittees(savedCommittees.length > 0 ? savedCommittees : mockCommittees);
        setProjects(savedProjects.length > 0 ? savedProjects : mockProjects);
        setSurveys(savedSurveys.length > 0 ? savedSurveys : mockSurveys);
      } else {
        setCommittees(mockCommittees);
        setProjects(mockProjects);
        setSurveys(mockSurveys);
        
        dataIsolationService.saveData('committees', mockCommittees);
        dataIsolationService.saveData('projects', mockProjects);
        dataIsolationService.saveData('surveys', mockSurveys);
      }
      setLoading(false);
    };

    if (currentYear) {
      initializeData();
    }
  }, [currentYear]);

  const handleTabChange = useCallback((event, newValue) => {
    setActiveTab(newValue);
  }, []);

  const formatDate = useCallback((date) => {
    if (!date) return '';
    const dateObj = date instanceof Date ? date : new Date(date);
    return dateObj.toLocaleDateString('de-DE', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric'
    });
  }, []);

  const getDaysRemaining = useCallback((date) => {
    if (!date) return null;
    const dateObj = date instanceof Date ? date : new Date(date);
    const today = new Date();
    const diffTime = dateObj - today;
    return Math.ceil(diffTime / (1000 * 60 * 60 * 24));
  }, []);

  const getStatusColor = useCallback((status) => {
    switch (status) {
      case 'completed': return 'success';
      case 'active': return 'primary';
      case 'planned': return 'warning';
      case 'overdue': return 'error';
      case 'on_hold': return 'default';
      default: return 'default';
    }
  }, []);

  const getStatusText = useCallback((status) => {
    switch (status) {
      case 'completed': return 'Abgeschlossen';
      case 'active': return 'Aktiv';
      case 'planned': return 'Geplant';
      case 'overdue': return 'Überfällig';
      case 'on_hold': return 'Pausiert';
      default: return status;
    }
  }, []);

  const getPriorityColor = useCallback((priority) => {
    switch (priority) {
      case 'high': return 'error';
      case 'medium': return 'warning';
      case 'low': return 'info';
      default: return 'default';
    }
  }, []);

  const getPriorityText = useCallback((priority) => {
    switch (priority) {
      case 'high': return 'Hoch';
      case 'medium': return 'Mittel';
      case 'low': return 'Niedrig';
      default: return priority;
    }
  }, []);

  const getProgressColor = useCallback((progress) => {
    if (progress >= 80) return 'success';
    if (progress >= 50) return 'primary';
    if (progress >= 25) return 'warning';
    return 'error';
  }, []);

  const calculateProjectProgress = useCallback((tasks) => {
    if (!tasks || tasks.length === 0) return 0;
    const completedTasks = tasks.filter(task => task.completed).length;
    return Math.round((completedTasks / tasks.length) * 100);
  }, []);

  // User committees (committees where user is a member)
  const userCommittees = useMemo(() => {
    return committees.filter(committee => 
      committee.members.some(member => member.id === user?.id) ||
      committee.userRole
    );
  }, [committees, user]);

  const canCreateContent = useCallback((committeeId) => {
    const committee = committees.find(c => c.id === committeeId);
    return committee && committee.userRole === 'Leitung';
  }, [committees]);

  const handleCreateDialogOpen = useCallback(() => {
    setCreateDialog(true);
    setFormData({});
    setFormErrors({});
    setCreateType('');
  }, []);

  const handleCreateDialogClose = useCallback(() => {
    setCreateDialog(false);
    setFormData({});
    setFormErrors({});
    setCreateType('');
  }, []);

  const handleFormDataChange = useCallback((field, value) => {
    setFormData(prev => ({ ...prev, [field]: value }));
    if (formErrors[field]) {
      setFormErrors(prev => ({ ...prev, [field]: '' }));
    }
  }, [formErrors]);

  const validateForm = useCallback(() => {
    const errors = {};
    
    if (createType === 'committee') {
      if (!formData.name?.trim()) errors.name = 'Name ist erforderlich';
      if (!formData.description?.trim()) errors.description = 'Beschreibung ist erforderlich';
    } else if (createType === 'project') {
      if (!formData.title?.trim()) errors.title = 'Titel ist erforderlich';
      if (!formData.description?.trim()) errors.description = 'Beschreibung ist erforderlich';
      if (!formData.committee) errors.committee = 'Komitee ist erforderlich';
      if (!formData.deadline) errors.deadline = 'Deadline ist erforderlich';
    } else if (createType === 'survey') {
      if (!formData.title?.trim()) errors.title = 'Titel ist erforderlich';
      if (!formData.description?.trim()) errors.description = 'Beschreibung ist erforderlich';
      if (!formData.committee) errors.committee = 'Komitee ist erforderlich';
      if (!formData.expiresAt) errors.expiresAt = 'Ablaufdatum ist erforderlich';
      if (!formData.options?.length || formData.options.some(opt => !opt.trim())) {
        errors.options = 'Mindestens zwei Optionen sind erforderlich';
      }
    }
    
    setFormErrors(errors);
    return Object.keys(errors).length === 0;
  }, [createType, formData]);

  const handleCreate = useCallback(() => {
    if (!validateForm()) return;
    
    const newItem = {
      id: `${createType}_${Date.now()}`,
      createdAt: new Date(),
      ...formData
    };
    
    if (createType === 'committee') {
      newItem.projects = [];
      newItem.surveys = [];
      newItem.members = [{ id: user?.id, name: user?.name, role: 'Leitung' }];
      newItem.userRole = 'Leitung';
      setCommittees(prev => {
        const updated = [...prev, newItem];
        dataIsolationService.saveData('committees', updated);
        return updated;
      });
    } else if (createType === 'project') {
      newItem.status = 'pending';
      newItem.files = [];
      setProjects(prev => {
        const updated = [...prev, newItem];
        dataIsolationService.saveData('projects', updated);
        return updated;
      });
    } else if (createType === 'survey') {
      newItem.isActive = true;
      setSurveys(prev => {
        const updated = [...prev, newItem];
        dataIsolationService.saveData('surveys', updated);
        return updated;
      });
    }
    
    handleCreateDialogClose();
  }, [createType, formData, validateForm, user]);

  const handleDetailsOpen = useCallback((item, type) => {
    setSelectedItem(item);
    setSelectedItemType(type);
    if (type === 'committee') {
      setSelectedCommittee(item);
      setCommitteeDetailTab(0);
    }
    setDetailsDialog(true);
  }, []);

  const handleDetailsClose = useCallback(() => {
    setDetailsDialog(false);
    setSelectedItem(null);
    setSelectedItemType('');
    setSelectedCommittee(null);
    setCommitteeDetailTab(0);
  }, []);

  const handleEditOpen = useCallback((item, type) => {
    setSelectedItem(item);
    setSelectedItemType(type);
    setFormData({
      name: item.name || item.title,
      description: item.description,
      committee: item.committee,
      deadline: item.deadline,
      expiresAt: item.expiresAt,
      options: item.options || []
    });
    setFormErrors({});
    setEditDialog(true);
  }, []);

  const handleEditClose = useCallback(() => {
    setEditDialog(false);
    setSelectedItem(null);
    setSelectedItemType('');
    setFormData({});
    setFormErrors({});
  }, []);

  const handleEditSave = useCallback(() => {
    if (!validateForm()) return;
    
    const updatedItem = {
      ...selectedItem,
      ...formData,
      [selectedItemType === 'committee' ? 'name' : 'title']: formData.name || formData.title
    };
    
    if (selectedItemType === 'committee') {
      setCommittees(prev => {
        const updated = prev.map(item => item.id === selectedItem.id ? updatedItem : item);
        dataIsolationService.saveData('committees', updated);
        return updated;
      });
    } else if (selectedItemType === 'project') {
      setProjects(prev => {
        const updated = prev.map(item => item.id === selectedItem.id ? updatedItem : item);
        dataIsolationService.saveData('projects', updated);
        return updated;
      });
    } else if (selectedItemType === 'survey') {
      setSurveys(prev => {
        const updated = prev.map(item => item.id === selectedItem.id ? updatedItem : item);
        dataIsolationService.saveData('surveys', updated);
        return updated;
      });
    }
    
    handleEditClose();
  }, [selectedItem, selectedItemType, formData, validateForm]);

  const handleUploadOpen = useCallback((item) => {
    setSelectedItem(item);
    setUploadFiles([]);
    setUploadDialog(true);
  }, []);

  const handleUploadClose = useCallback(() => {
    setUploadDialog(false);
    setSelectedItem(null);
    setUploadFiles([]);
  }, []);

  const handleFileUpload = useCallback((event) => {
    const files = Array.from(event.target.files);
    setUploadFiles(files);
  }, []);

  const handleUploadSave = useCallback(() => {
    if (uploadFiles.length === 0) return;
    
    const newFiles = uploadFiles.map(file => ({
      id: `file_${Date.now()}_${Math.random()}`,
      name: file.name,
      size: file.size,
      type: file.type,
      uploadedAt: new Date(),
      uploadedBy: user?.name || 'Unbekannt'
    }));
    
    setProjects(prev => {
      const updated = prev.map(project => 
        project.id === selectedItem.id 
          ? { ...project, files: [...(project.files || []), ...newFiles] }
          : project
      );
      dataIsolationService.saveData('projects', updated);
      return updated;
    });
    
    handleUploadClose();
  }, [uploadFiles, selectedItem, user]);

  const handleCommitteeSelect = useCallback((committee) => {
    setSelectedCommittee(committee);
    setCommitteeDetailTab(0);
  }, []);

  const handleJoinCommittee = useCallback((committee) => {
    if (committee.isOpen) {
      // Direct join for open committees
      const updatedCommittee = {
        ...committee,
        members: [...committee.members, { id: user?.id, name: user?.name, role: 'Mitglied' }],
        userRole: 'Mitglied'
      };
      
      setCommittees(prev => {
        const updated = prev.map(c => c.id === committee.id ? updatedCommittee : c);
        dataIsolationService.saveData('committees', updated);
        return updated;
      });
    } else {
      // Show join request dialog for closed committees
      setSelectedItem(committee);
      setJoinRequestDialog(true);
    }
  }, [user]);

  const handleJoinRequest = useCallback(() => {
    // In a real app, this would send a request to committee leaders
    console.log('Join request sent:', {
      committee: selectedItem?.name,
      user: user?.name,
      message: joinRequestMessage
    });
    
    setJoinRequestDialog(false);
    setJoinRequestMessage('');
    setSelectedItem(null);
  }, [selectedItem, user, joinRequestMessage]);

  // Filter and sort committees for overview
  const filteredCommittees = useMemo(() => {
    let filtered = committees.filter(committee => {
      const matchesSearch = committee.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
                           committee.description.toLowerCase().includes(searchTerm.toLowerCase());
      const matchesCategory = filterCategory === 'all' || committee.category === filterCategory;
      return matchesSearch && matchesCategory;
    });

    // Sort by filter criteria
    if (filterCategory === 'popular') {
      filtered.sort((a, b) => (b.popularity || 0) - (a.popularity || 0));
    } else if (filterCategory === 'newest') {
      filtered.sort((a, b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0));
    }

    return filtered;
  }, [committees, searchTerm, filterCategory]);

  if (loading) {
    return (
      <Box sx={{ p: 3 }}>
        <Typography>Lade Komitees und Projekte...</Typography>
      </Box>
    );
  }

  return (
    <Box sx={{ p: 3 }}>
      <Typography variant="h4" gutterBottom>
        Komitees & Projekte
      </Typography>

      <Box sx={{ borderBottom: 1, borderColor: 'divider', mb: 3 }}>
        <Tabs value={activeTab} onChange={handleTabChange}>
          <Tab label="Alle Komitees" />
          <Tab label="Meine Komitees" />
          <Tab label="Projekte" />
          <Tab label="Umfragen" />
        </Tabs>
      </Box>

      {/* Committee Overview */}
      <TabPanel value={activeTab} index={0}>
        {/* Search and Filter */}
        <Box sx={{ mb: 3, display: 'flex', gap: 2, flexWrap: 'wrap' }}>
          <TextField
            placeholder="Komitees durchsuchen..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            InputProps={{
              startAdornment: <SearchIcon sx={{ mr: 1, color: 'text.secondary' }} />
            }}
            sx={{ flexGrow: 1, minWidth: 250 }}
          />
          <FormControl sx={{ minWidth: 150 }}>
            <InputLabel>Kategorie</InputLabel>
            <Select
              value={filterCategory}
              onChange={(e) => setFilterCategory(e.target.value)}
              label="Kategorie"
              startAdornment={<FilterIcon sx={{ mr: 1, color: 'text.secondary' }} />}
            >
              <MenuItem value="all">Alle</MenuItem>
              <MenuItem value="event">Veranstaltung</MenuItem>
              <MenuItem value="media">Medien</MenuItem>
              <MenuItem value="creative">Kreativ</MenuItem>
              <MenuItem value="finance">Finanzen</MenuItem>
              <MenuItem value="technical">Technik</MenuItem>
              <MenuItem value="popular">Beliebteste</MenuItem>
              <MenuItem value="newest">Neueste</MenuItem>
            </Select>
          </FormControl>
        </Box>

        {/* Committee Cards */}
        <Grid container spacing={3}>
          {filteredCommittees.map((committee) => {
            const isMember = committee.members.some(member => member.id === user?.id) || committee.userRole;
            
            return (
              <Grid item xs={12} sm={6} md={4} lg={4} key={committee.id}>
                <Card sx={{ 
                  height: '100%', 
                  display: 'flex', 
                  flexDirection: 'column',
                  borderRadius: 2,
                  boxShadow: (theme) => theme.palette.mode === 'dark' 
                    ? '0 2px 8px rgba(0,0,0,0.3)' 
                    : '0 2px 8px rgba(0,0,0,0.1)',
                  transition: 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)',
                  border: (theme) => theme.palette.mode === 'dark' 
                    ? '1px solid rgba(255,255,255,0.1)' 
                    : '1px solid rgba(0,0,0,0.05)',
                  '&:hover': {
                    transform: 'translateY(-4px)',
                    boxShadow: (theme) => theme.palette.mode === 'dark' 
                      ? '0 8px 24px rgba(0,0,0,0.4)' 
                      : '0 8px 24px rgba(0,0,0,0.15)',
                    borderColor: (theme) => `${theme.palette.primary.main}40`
                  }
                }}>
                  <CardContent sx={{ flexGrow: 1 }}>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, mb: 2 }}>
                      <GroupIcon color="primary" />
                      <Box sx={{ flexGrow: 1 }}>
                        <Typography variant="h6">{committee.name}</Typography>
                        <Box sx={{ display: 'flex', gap: 1, mt: 1 }}>
                          <Chip 
                            label={committee.isOpen ? 'Offen' : 'Geschlossen'} 
                            color={committee.isOpen ? 'success' : 'default'}
                            size="small"
                          />
                          {isMember && (
                            <Chip 
                              label="Mitglied" 
                              color="primary"
                              size="small"
                            />
                          )}
                        </Box>
                      </Box>
                    </Box>
                    
                    <Typography variant="body2" color="text.secondary" paragraph>
                      {committee.description}
                    </Typography>
                    
                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mt: 2 }}>
                      <Box sx={{ display: 'flex', gap: 2 }}>
                        <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                          <ProjectIcon fontSize="small" color="action" />
                          <Typography variant="body2" color="text.secondary">
                            {committee.projects?.length || 0}
                          </Typography>
                        </Box>
                        <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                          <PollIcon fontSize="small" color="action" />
                          <Typography variant="body2" color="text.secondary">
                            {committee.surveys?.length || 0}
                          </Typography>
                        </Box>
                        <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                          <PeopleIcon fontSize="small" color="action" />
                          <Typography variant="body2" color="text.secondary">
                            {committee.members?.length || 0}
                          </Typography>
                        </Box>
                      </Box>
                    </Box>
                    
                    {/* Member Avatars */}
                    <Box sx={{ mt: 2 }}>
                      <AvatarGroup max={4} sx={{ justifyContent: 'flex-start' }}>
                        {committee.members?.map((member, index) => (
                          <Tooltip key={member.id} title={`${member.name} (${member.role})`}>
                            <Avatar sx={{ width: 32, height: 32, fontSize: '0.875rem' }}>
                              {member.name.split(' ').map(n => n[0]).join('')}
                            </Avatar>
                          </Tooltip>
                        ))}
                      </AvatarGroup>
                    </Box>
                  </CardContent>
                  
                  <CardActions>
                    <Button 
                      size="small" 
                      startIcon={<ViewIcon />}
                      onClick={() => handleDetailsOpen(committee, 'committee')}
                    >
                      Details
                    </Button>
                    {!isMember && (
                      <Button 
                        size="small" 
                        startIcon={<PersonAddIcon />}
                        onClick={() => handleJoinCommittee(committee)}
                        color="primary"
                      >
                        Beitreten
                      </Button>
                    )}
                  </CardActions>
                </Card>
              </Grid>
            );
          })}
        </Grid>
        
        {filteredCommittees.length === 0 && (
          <Box sx={{ textAlign: 'center', py: 4 }}>
            <Typography variant="h6" color="text.secondary">
              Keine Komitees gefunden
            </Typography>
            <Typography variant="body2" color="text.secondary">
              Versuche andere Suchbegriffe oder Filter
            </Typography>
          </Box>
        )}
      </TabPanel>

      {/* Meine Komitees */}
      <TabPanel value={activeTab} index={1}>
        <Grid container spacing={3}>
          {userCommittees.map((committee) => (
            <Grid item xs={12} sm={6} md={4} lg={4} key={committee.id}>
              <Card>
                <CardContent>
                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, mb: 2 }}>
                    <GroupIcon color="primary" />
                    <Box>
                      <Typography variant="h6">{committee.name}</Typography>
                      <Chip
                        label={committee.userRole}
                        color={committee.userRole === 'Leitung' ? 'primary' : 'default'}
                        size="small"
                      />
                    </Box>
                  </Box>
                  
                  <Typography variant="body2" color="text.secondary" paragraph>
                    {committee.description}
                  </Typography>
                  
                  <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                    <Box sx={{ display: 'flex', gap: 2 }}>
                      <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                        <ProjectIcon fontSize="small" color="action" />
                        <Typography variant="body2" color="text.secondary">
                          {committee.projects?.length || 0} Projekte
                        </Typography>
                      </Box>
                      <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                        <PollIcon fontSize="small" color="action" />
                        <Typography variant="body2" color="text.secondary">
                          {committee.surveys?.length || 0} Umfragen
                        </Typography>
                      </Box>
                    </Box>
                  </Box>
                  
                  <Box sx={{ mt: 2 }}>
                    <Typography variant="body2" color="text.secondary" gutterBottom>
                      Mitglieder ({committee.members?.length || 0}):
                    </Typography>
                    <AvatarGroup max={4}>
                      {committee.members?.map((member) => (
                        <Tooltip key={member.id} title={`${member.name} (${member.role})`}>
                          <Avatar sx={{ width: 32, height: 32, fontSize: '0.875rem' }}>
                            {member.name.split(' ').map(n => n[0]).join('')}
                          </Avatar>
                        </Tooltip>
                      ))}
                    </AvatarGroup>
                  </Box>
                </CardContent>
                
                <CardActions>
                  <Button 
                    size="small" 
                    startIcon={<ViewIcon />}
                    onClick={() => handleDetailsOpen(committee, 'committee')}
                  >
                    Details
                  </Button>
                  {committee.userRole === 'Leitung' && (
                    <Button 
                      size="small" 
                      startIcon={<EditIcon />}
                      onClick={() => handleEditOpen(committee, 'committee')}
                    >
                      Bearbeiten
                    </Button>
                  )}
                </CardActions>
              </Card>
            </Grid>
          ))}
        </Grid>
      </TabPanel>

      {/* Projekte */}
      <TabPanel value={activeTab} index={2}>
        <Grid container spacing={3}>
          {projects.map((project) => {
            const calculatedProgress = project.progress !== undefined ? project.progress : calculateProjectProgress(project.tasks);
            const daysRemaining = getDaysRemaining(project.deadline);
            const isOverdue = daysRemaining < 0;
            
            return (
              <Grid item xs={12} sm={6} md={6} lg={4} key={project.id}>
                <Card sx={{ 
                  height: '100%', 
                  display: 'flex', 
                  flexDirection: 'column',
                  borderRadius: 2,
                  boxShadow: (theme) => theme.palette.mode === 'dark' 
                    ? '0 2px 8px rgba(0,0,0,0.3)' 
                    : '0 2px 8px rgba(0,0,0,0.1)',
                  transition: 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)',
                  border: (theme) => theme.palette.mode === 'dark' 
                    ? '1px solid rgba(255,255,255,0.1)' 
                    : '1px solid rgba(0,0,0,0.05)',
                  '&:hover': {
                    transform: 'translateY(-4px)',
                    boxShadow: (theme) => theme.palette.mode === 'dark' 
                      ? '0 8px 24px rgba(0,0,0,0.4)' 
                      : '0 8px 24px rgba(0,0,0,0.15)',
                    borderColor: (theme) => theme.palette.primary.main + '40'
                  }
                }}>
                  <CardContent sx={{ flexGrow: 1 }}>
                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 2 }}>
                      <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
                        <ProjectIcon color="primary" />
                        <Box>
                          <Typography variant="h6">{project.title}</Typography>
                          <Typography variant="body2" color="text.secondary">
                            {project.committee}
                          </Typography>
                        </Box>
                      </Box>
                      <Box sx={{ display: 'flex', flexDirection: 'column', gap: 0.5, alignItems: 'flex-end' }}>
                        <Chip
                          label={getStatusText(project.status)}
                          color={getStatusColor(project.status)}
                          size="small"
                        />
                        {project.priority && (
                          <Chip
                            label={getPriorityText(project.priority)}
                            color={getPriorityColor(project.priority)}
                            size="small"
                            variant="outlined"
                          />
                        )}
                      </Box>
                    </Box>
                    
                    <Typography variant="body2" color="text.secondary" paragraph>
                      {project.description}
                    </Typography>
                    
                    {/* Progress Bar */}
                    <Box sx={{ mb: 2 }}>
                      <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 1 }}>
                        <Typography variant="body2" color="text.secondary">
                          Fortschritt
                        </Typography>
                        <Typography variant="body2" color="text.secondary">
                          {calculatedProgress}%
                        </Typography>
                      </Box>
                      <LinearProgress 
                        variant="determinate" 
                        value={calculatedProgress} 
                        color={getProgressColor(calculatedProgress)}
                        sx={{ height: 8, borderRadius: 4 }}
                      />
                    </Box>
                    
                    {/* Assigned To */}
                    {project.assignedTo && project.assignedTo.length > 0 && (
                      <Box sx={{ mb: 2 }}>
                        <Typography variant="body2" color="text.secondary" gutterBottom>
                          Zugewiesen an:
                        </Typography>
                        <AvatarGroup max={3} sx={{ justifyContent: 'flex-start' }}>
                          {project.assignedTo.map((person, index) => (
                            <Tooltip key={index} title={person}>
                              <Avatar sx={{ width: 28, height: 28, fontSize: '0.75rem' }}>
                                {person.split(' ').map(n => n[0]).join('')}
                              </Avatar>
                            </Tooltip>
                          ))}
                        </AvatarGroup>
                      </Box>
                    )}
                    
                    <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                      <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                        <TimeIcon fontSize="small" color={isOverdue ? "error" : "action"} />
                        <Typography 
                          variant="body2" 
                          color={isOverdue ? "error" : "text.secondary"}
                          sx={{ fontWeight: isOverdue ? 'bold' : 'normal' }}
                        >
                          {formatDate(project.deadline)}
                          {daysRemaining !== null && (
                            <span>
                              {isOverdue 
                                ? ` (${Math.abs(daysRemaining)} Tage überfällig)` 
                                : ` (${daysRemaining} Tage)`
                              }
                            </span>
                          )}
                        </Typography>
                      </Box>
                      {project.files && project.files.length > 0 && (
                        <Typography variant="body2" color="text.secondary">
                          {project.files.length} Datei(en)
                        </Typography>
                      )}
                    </Box>
                    
                    {/* Tasks Summary */}
                    {project.tasks && project.tasks.length > 0 && (
                      <Box sx={{ mt: 2, pt: 2, borderTop: 1, borderColor: 'divider' }}>
                        <Typography variant="body2" color="text.secondary">
                          Aufgaben: {project.tasks.filter(t => t.completed).length}/{project.tasks.length} abgeschlossen
                        </Typography>
                      </Box>
                    )}
                  </CardContent>
                
                <CardActions>
                  <Button 
                    size="small" 
                    startIcon={<ViewIcon />}
                    onClick={() => handleDetailsOpen(project, 'project')}
                  >
                    Details
                  </Button>
                  {canCreateContent(project.committeeId) && (
                    <>
                      <Button 
                        size="small" 
                        startIcon={<EditIcon />}
                        onClick={() => handleEditOpen(project, 'project')}
                      >
                        Bearbeiten
                      </Button>
                      <Button 
                        size="small" 
                        startIcon={<UploadIcon />}
                        onClick={() => handleUploadOpen(project)}
                      >
                        Upload
                      </Button>
                    </>
                  )}
                </CardActions>
              </Card>
            </Grid>
          ))}
        </Grid>
      </TabPanel>

      {/* Umfragen */}
      <TabPanel value={activeTab} index={3}>
        <Grid container spacing={3}>
          {surveys.filter(s => s.isActive).map((survey) => (
            <Grid item xs={12} md={6} key={survey.id}>
              <Card>
                <CardContent>
                  <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 2 }}>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
                      <PollIcon color="primary" />
                      <Box>
                        <Typography variant="h6">{survey.title}</Typography>
                        <Typography variant="body2" color="text.secondary">
                          {survey.committee}
                        </Typography>
                      </Box>
                    </Box>
                    <Chip
                      label={getDaysRemaining(survey.expiresAt) > 0 ? 'Aktiv' : 'Abgelaufen'}
                      color={getDaysRemaining(survey.expiresAt) > 0 ? 'success' : 'error'}
                      size="small"
                    />
                  </Box>
                  
                  <Typography variant="body2" color="text.secondary" paragraph>
                    {survey.description}
                  </Typography>
                  
                  <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
                      <TimeIcon fontSize="small" color="action" />
                      <Typography variant="body2" color="text.secondary">
                        Bis {formatDate(survey.expiresAt)}
                      </Typography>
                    </Box>
                    <Typography variant="body2" color="text.secondary">
                      {survey.options?.length || 0} Optionen
                    </Typography>
                  </Box>
                </CardContent>
                
                <CardActions>
                  <Button 
                    size="small" 
                    startIcon={<ViewIcon />}
                    onClick={() => handleDetailsOpen(survey, 'survey')}
                  >
                    Details
                  </Button>
                  {canCreateContent(survey.committeeId) && (
                    <Button 
                      size="small" 
                      startIcon={<EditIcon />}
                      onClick={() => handleEditOpen(survey, 'survey')}
                    >
                      Bearbeiten
                    </Button>
                  )}
                </CardActions>
              </Card>
            </Grid>
          ))}
        </Grid>
      </TabPanel>

      {/* Floating Action Button */}
      <Fab
        color="primary"
        aria-label="add"
        sx={{ 
          position: 'fixed', 
          bottom: 24, 
          right: 24, 
          zIndex: 9999,
          boxShadow: 3
        }}
        onClick={handleCreateDialogOpen}
      >
        <AddIcon />
      </Fab>

      {/* Committee Details Dialog */}
      <Dialog 
        open={detailsDialog && selectedItemType === 'committee'} 
        onClose={handleDetailsClose} 
        maxWidth="md" 
        fullWidth
        PaperProps={{
          sx: { minHeight: '70vh' }
        }}
      >
        <DialogTitle>
          <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
            <GroupIcon color="primary" />
            <Box>
              <Typography variant="h5">{selectedCommittee?.name}</Typography>
              <Typography variant="body2" color="text.secondary">
                {selectedCommittee?.members?.length || 0} Mitglieder
              </Typography>
            </Box>
          </Box>
        </DialogTitle>
        
        <DialogContent sx={{ p: 0 }}>
          <Box sx={{ borderBottom: 1, borderColor: 'divider' }}>
            <Tabs 
              value={committeeDetailTab} 
              onChange={(e, newValue) => setCommitteeDetailTab(newValue)}
              variant="fullWidth"
            >
              <Tab label="Info" />
              <Tab label="Projekte" />
              <Tab label="Umfragen" />
              <Tab label="Mitglieder" />
            </Tabs>
          </Box>
          
          {/* Info Tab */}
          <TabPanel value={committeeDetailTab} index={0}>
            <Box sx={{ p: 2 }}>
              <Typography variant="h6" gutterBottom>Beschreibung</Typography>
              <Typography variant="body1" paragraph>
                {selectedCommittee?.description}
              </Typography>
              
              <Grid container spacing={3} sx={{ mt: 2 }}>
                <Grid item xs={12} sm={6}>
                  <Box sx={{ p: 2, bgcolor: 'background.paper', borderRadius: 1, border: 1, borderColor: 'divider' }}>
                    <Typography variant="h6" gutterBottom>Status</Typography>
                    <Chip 
                      label={selectedCommittee?.isOpen ? 'Offen' : 'Geschlossen'}
                      color={selectedCommittee?.isOpen ? 'success' : 'warning'}
                      sx={{ mb: 1 }}
                    />
                    <Typography variant="body2" color="text.secondary">
                      {selectedCommittee?.isOpen ? 'Neue Mitglieder können direkt beitreten' : 'Beitritt nur nach Anfrage möglich'}
                    </Typography>
                  </Box>
                </Grid>
                
                <Grid item xs={12} sm={6}>
                  <Box sx={{ p: 2, bgcolor: 'background.paper', borderRadius: 1, border: 1, borderColor: 'divider' }}>
                    <Typography variant="h6" gutterBottom>Kategorie</Typography>
                    <Chip 
                      label={(() => {
                        const categoryLabels = {
                          'event': 'Veranstaltung',
                          'media': 'Medien',
                          'creative': 'Kreativ',
                          'finance': 'Finanzen',
                          'technical': 'Technik'
                        };
                        return categoryLabels[selectedCommittee?.category] || selectedCommittee?.category;
                      })()}
                      variant="outlined"
                    />
                  </Box>
                </Grid>
              </Grid>
            </Box>
          </TabPanel>
          
          {/* Projects Tab */}
          <TabPanel value={committeeDetailTab} index={1}>
            <Box sx={{ p: 2 }}>
              <Typography variant="h6" gutterBottom>Projekte</Typography>
              {selectedCommittee?.projects?.length > 0 ? (
                <Grid container spacing={2}>
                  {projects.filter(p => selectedCommittee.projects.includes(p.id)).map((project) => (
                    <Grid item xs={12} key={project.id}>
                      <Card sx={{
                        borderRadius: 2,
                        boxShadow: (theme) => theme.palette.mode === 'dark' 
                          ? '0 2px 8px rgba(0,0,0,0.3)' 
                          : '0 2px 8px rgba(0,0,0,0.1)',
                        transition: 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)',
                        border: (theme) => theme.palette.mode === 'dark' 
                          ? '1px solid rgba(255,255,255,0.1)' 
                          : '1px solid rgba(0,0,0,0.05)',
                        '&:hover': {
                          transform: 'translateY(-2px)',
                          boxShadow: (theme) => theme.palette.mode === 'dark' 
                            ? '0 4px 16px rgba(0,0,0,0.4)' 
                            : '0 4px 16px rgba(0,0,0,0.15)',
                          borderColor: (theme) => `${theme.palette.primary.main}40`
                        }
                      }}>
                        <CardContent>
                          <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, mb: 1 }}>
                            <ProjectIcon color="primary" />
                            <Typography variant="h6">{project.title}</Typography>
                            <Chip 
                              label={getStatusText(project.status)}
                              sx={{ 
                                backgroundColor: getStatusColor(project.status),
                                color: 'white',
                                fontWeight: 'bold'
                              }}
                              size="small"
                            />
                            {project.priority && (
                              <Chip 
                                label={getPriorityText(project.priority)}
                                sx={{ 
                                  backgroundColor: getPriorityColor(project.priority),
                                  color: 'white',
                                  fontWeight: 'bold'
                                }}
                                size="small"
                              />
                            )}
                          </Box>
                          <Typography variant="body2" color="text.secondary" paragraph>
                            {project.description}
                          </Typography>
                          
                          {/* Progress Bar */}
                          {project.progress !== undefined && (
                            <Box sx={{ mb: 2 }}>
                              <Box sx={{ display: 'flex', justifyContent: 'space-between', mb: 1 }}>
                                <Typography variant="body2" color="text.secondary">
                                  Fortschritt
                                </Typography>
                                <Typography variant="body2" color="text.secondary">
                                  {project.progress}%
                                </Typography>
                              </Box>
                              <LinearProgress 
                                variant="determinate" 
                                value={project.progress} 
                                sx={{
                                  height: 8,
                                  borderRadius: 4,
                                  backgroundColor: 'grey.200',
                                  '& .MuiLinearProgress-bar': {
                                    backgroundColor: getProgressColor(project.progress),
                                    borderRadius: 4
                                  }
                                }}
                              />
                            </Box>
                          )}
                          
                          {/* Assigned Members */}
                          {project.assignedTo && project.assignedTo.length > 0 && (
                            <Box sx={{ mb: 2 }}>
                              <Typography variant="body2" color="text.secondary" gutterBottom>
                                Zugewiesen an:
                              </Typography>
                              <AvatarGroup max={4} sx={{ justifyContent: 'flex-start' }}>
                                {project.assignedTo.map((member, index) => (
                                  <Avatar 
                                    key={index}
                                    sx={{ 
                                      width: 32, 
                                      height: 32,
                                      fontSize: '0.875rem',
                                      bgcolor: `hsl(${(member.charCodeAt(0) * 137.508) % 360}, 70%, 50%)`
                                    }}
                                  >
                                    {member.charAt(0).toUpperCase()}
                                  </Avatar>
                                ))}
                              </AvatarGroup>
                            </Box>
                          )}
                          
                          {/* Tasks Summary */}
                          {project.tasks && (
                            <Box sx={{ mb: 2 }}>
                              <Typography variant="body2" color="text.secondary">
                                Aufgaben: {project.tasks.completed}/{project.tasks.total} abgeschlossen
                              </Typography>
                            </Box>
                          )}
                          
                          {project.deadline && (
                            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                              <TimeIcon fontSize="small" color="action" />
                              <Typography variant="body2" color="text.secondary">
                                Deadline: {new Date(project.deadline).toLocaleDateString('de-DE')}
                              </Typography>
                            </Box>
                          )}
                        </CardContent>
                      </Card>
                    </Grid>
                  ))}
                </Grid>
              ) : (
                <Box sx={{ textAlign: 'center', py: 4 }}>
                  <ProjectIcon sx={{ fontSize: 48, color: 'text.secondary', mb: 2 }} />
                  <Typography variant="h6" color="text.secondary">Keine Projekte</Typography>
                  <Typography variant="body2" color="text.secondary">
                    Dieses Komitee hat noch keine Projekte erstellt.
                  </Typography>
                </Box>
              )}
            </Box>
          </TabPanel>
          
          {/* Surveys Tab */}
          <TabPanel value={committeeDetailTab} index={2}>
            <Box sx={{ p: 2 }}>
              <Typography variant="h6" gutterBottom>Umfragen</Typography>
              {selectedCommittee?.surveys?.length > 0 ? (
                <Grid container spacing={2}>
                  {surveys.filter(s => selectedCommittee.surveys.includes(s.id)).map((survey) => {
                    const isActive = new Date(survey.expiresAt) > new Date();
                    const participationRate = survey.responses ? (survey.responses / (selectedCommittee?.members?.length || 1)) * 100 : 0;
                    
                    return (
                      <Grid item xs={12} key={survey.id}>
                        <Card sx={{
                          borderRadius: 2,
                          boxShadow: (theme) => theme.palette.mode === 'dark' 
                            ? '0 2px 8px rgba(0,0,0,0.3)' 
                            : '0 2px 8px rgba(0,0,0,0.1)',
                          transition: 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)',
                          border: (theme) => theme.palette.mode === 'dark' 
                            ? '1px solid rgba(255,255,255,0.1)' 
                            : '1px solid rgba(0,0,0,0.05)',
                          '&:hover': {
                            transform: 'translateY(-2px)',
                            boxShadow: (theme) => theme.palette.mode === 'dark' 
                              ? '0 4px 16px rgba(0,0,0,0.4)' 
                              : '0 4px 16px rgba(0,0,0,0.15)',
                            borderColor: (theme) => `${theme.palette.primary.main}40`
                          }
                        }}>
                          <CardContent>
                            <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, mb: 1 }}>
                              <PollIcon color="primary" />
                              <Typography variant="h6">{survey.title}</Typography>
                              <Chip 
                                label={isActive ? 'Aktiv' : 'Abgelaufen'}
                                color={isActive ? 'success' : 'default'}
                                size="small"
                              />
                              {survey.type && (
                                <Chip 
                                  label={survey.type === 'multiple' ? 'Mehrfachauswahl' : survey.type === 'single' ? 'Einzelauswahl' : 'Text'}
                                  variant="outlined"
                                  size="small"
                                />
                              )}
                            </Box>
                            <Typography variant="body2" color="text.secondary" paragraph>
                              {survey.description}
                            </Typography>
                            
                            {/* Participation Progress */}
                            <Box sx={{ mb: 2 }}>
                              <Box sx={{ display: 'flex', justifyContent: 'space-between', mb: 1 }}>
                                <Typography variant="body2" color="text.secondary">
                                  Teilnahme
                                </Typography>
                                <Typography variant="body2" color="text.secondary">
                                  {survey.responses || 0}/{selectedCommittee?.members?.length || 0} ({Math.round(participationRate)}%)
                                </Typography>
                              </Box>
                              <LinearProgress 
                                variant="determinate" 
                                value={participationRate} 
                                sx={{
                                  height: 6,
                                  borderRadius: 3,
                                  backgroundColor: 'grey.200',
                                  '& .MuiLinearProgress-bar': {
                                    backgroundColor: participationRate > 75 ? '#4caf50' : participationRate > 50 ? '#ff9800' : '#f44336',
                                    borderRadius: 3
                                  }
                                }}
                              />
                            </Box>
                            
                            {/* Survey Results Preview */}
                            {survey.results && (
                              <Box sx={{ mb: 2 }}>
                                <Typography variant="body2" color="text.secondary" gutterBottom>
                                  Ergebnisse:
                                </Typography>
                                {survey.results.slice(0, 3).map((result, index) => (
                                  <Box key={index} sx={{ mb: 1 }}>
                                    <Box sx={{ display: 'flex', justifyContent: 'space-between', mb: 0.5 }}>
                                      <Typography variant="body2">
                                        {result.option}
                                      </Typography>
                                      <Typography variant="body2" color="text.secondary">
                                        {result.votes} ({Math.round((result.votes / (survey.responses || 1)) * 100)}%)
                                      </Typography>
                                    </Box>
                                    <LinearProgress 
                                      variant="determinate" 
                                      value={(result.votes / (survey.responses || 1)) * 100} 
                                      sx={{
                                        height: 4,
                                        borderRadius: 2,
                                        backgroundColor: 'grey.100',
                                        '& .MuiLinearProgress-bar': {
                                          backgroundColor: `hsl(${210 + index * 30}, 70%, 50%)`,
                                          borderRadius: 2
                                        }
                                      }}
                                    />
                                  </Box>
                                ))}
                                {survey.results.length > 3 && (
                                  <Typography variant="body2" color="text.secondary" sx={{ mt: 1 }}>
                                    +{survey.results.length - 3} weitere Optionen
                                  </Typography>
                                )}
                              </Box>
                            )}
                            
                            <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                              <TimeIcon fontSize="small" color="action" />
                              <Typography variant="body2" color="text.secondary">
                                Läuft bis: {new Date(survey.expiresAt).toLocaleDateString('de-DE')}
                              </Typography>
                            </Box>
                          </CardContent>
                        </Card>
                      </Grid>
                    );
                  })}
                </Grid>
              ) : (
                <Box sx={{ textAlign: 'center', py: 4 }}>
                  <PollIcon sx={{ fontSize: 48, color: 'text.secondary', mb: 2 }} />
                  <Typography variant="h6" color="text.secondary">Keine Umfragen</Typography>
                  <Typography variant="body2" color="text.secondary">
                    Dieses Komitee hat noch keine Umfragen erstellt.
                  </Typography>
                </Box>
              )}
            </Box>
          </TabPanel>
          
          {/* Members Tab */}
          <TabPanel value={committeeDetailTab} index={3}>
            <Box sx={{ p: 2 }}>
              <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
                <Typography variant="h6">
                  Mitglieder ({selectedCommittee?.members?.length || 0})
                </Typography>
                {selectedCommittee?.userRole === 'Leitung' && (
                  <Button 
                    variant="outlined" 
                    startIcon={<PersonAddIcon />}
                    size="small"
                    onClick={() => {/* TODO: Implement invite functionality */}}
                  >
                    Einladen
                  </Button>
                )}
              </Box>
              
              <Grid container spacing={2}>
                {selectedCommittee?.members?.map((member) => {
                  const isLeader = member.role === 'Leitung';
                  const isCurrentUser = member.id === user?.id;
                  const canManage = selectedCommittee?.userRole === 'Leitung' && !isCurrentUser;
                  
                  return (
                    <Grid item xs={12} sm={6} md={4} key={member.id}>
                      <Card sx={{ 
                        height: '100%',
                        borderRadius: 2,
                        boxShadow: (theme) => theme.palette.mode === 'dark' 
                          ? '0 2px 8px rgba(0,0,0,0.3)' 
                          : '0 2px 8px rgba(0,0,0,0.1)',
                        transition: 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)',
                        border: (theme) => theme.palette.mode === 'dark' 
                          ? '1px solid rgba(255,255,255,0.1)' 
                          : '1px solid rgba(0,0,0,0.05)',
                        '&:hover': {
                          transform: 'translateY(-2px)',
                          boxShadow: (theme) => theme.palette.mode === 'dark' 
                            ? '0 4px 16px rgba(0,0,0,0.4)' 
                            : '0 4px 16px rgba(0,0,0,0.15)',
                          borderColor: (theme) => `${theme.palette.primary.main}40`
                        }
                      }}>
                        <CardContent sx={{ textAlign: 'center', p: 2 }}>
                          <Avatar 
                            sx={{ 
                              width: 56, 
                              height: 56, 
                              mx: 'auto', 
                              mb: 1,
                              bgcolor: `hsl(${(member.name.charCodeAt(0) * 137.508) % 360}, 70%, 50%)`
                            }}
                          >
                            {member.name.split(' ').map(n => n[0]).join('')}
                          </Avatar>
                          
                          <Typography variant="h6" gutterBottom>
                            {member.name}
                          </Typography>
                          
                          <Chip 
                            label={member.role}
                            color={isLeader ? 'primary' : 'default'}
                            size="small"
                            sx={{ mb: 1 }}
                          />
                          
                          {isCurrentUser && (
                            <Chip 
                              label="Du"
                              variant="outlined"
                              size="small"
                              sx={{ ml: 1, mb: 1 }}
                            />
                          )}
                          
                          {/* Member Stats */}
                          <Box sx={{ mt: 2, display: 'flex', justifyContent: 'space-around', fontSize: '0.875rem' }}>
                            <Box sx={{ textAlign: 'center' }}>
                              <Typography variant="body2" color="text.secondary">
                                Projekte
                              </Typography>
                              <Typography variant="body2" fontWeight="bold">
                                {projects.filter(p => p.assignedTo?.includes(member.name)).length}
                              </Typography>
                            </Box>
                            <Box sx={{ textAlign: 'center' }}>
                              <Typography variant="body2" color="text.secondary">
                                Seit
                              </Typography>
                              <Typography variant="body2" fontWeight="bold">
                                {member.joinedAt ? new Date(member.joinedAt).toLocaleDateString('de-DE', { month: 'short', year: '2-digit' }) : 'Unbekannt'}
                              </Typography>
                            </Box>
                          </Box>
                          
                          {/* Action Buttons */}
                          {canManage && (
                            <Box sx={{ mt: 2, display: 'flex', gap: 1, justifyContent: 'center' }}>
                              <IconButton 
                                size="small" 
                                color="primary"
                                title="Rolle ändern"
                                onClick={() => {/* TODO: Implement role change */}}
                              >
                                <EditIcon fontSize="small" />
                              </IconButton>
                              <IconButton 
                                size="small" 
                                color="error"
                                title="Entfernen"
                                onClick={() => {/* TODO: Implement member removal */}}
                              >
                                <DeleteIcon fontSize="small" />
                              </IconButton>
                            </Box>
                          )}
                        </CardContent>
                      </Card>
                    </Grid>
                  );
                })}
                
                {/* Add Member Card (for leaders) */}
                {selectedCommittee?.userRole === 'Leitung' && (
                  <Grid item xs={12} sm={6} md={4}>
                    <Card 
                      variant="outlined" 
                      sx={{ 
                        height: '100%', 
                        display: 'flex', 
                        alignItems: 'center', 
                        justifyContent: 'center',
                        cursor: 'pointer',
                        '&:hover': {
                          backgroundColor: 'action.hover'
                        }
                      }}
                      onClick={() => {/* TODO: Implement invite functionality */}}
                    >
                      <CardContent sx={{ textAlign: 'center' }}>
                        <PersonAddIcon sx={{ fontSize: 48, color: 'text.secondary', mb: 1 }} />
                        <Typography variant="h6" color="text.secondary">
                          Mitglied einladen
                        </Typography>
                        <Typography variant="body2" color="text.secondary">
                          Neue Mitglieder hinzufügen
                        </Typography>
                      </CardContent>
                    </Card>
                  </Grid>
                )}
              </Grid>
              
              {selectedCommittee?.members?.length === 0 && (
                <Box sx={{ textAlign: 'center', py: 4 }}>
                  <GroupIcon sx={{ fontSize: 48, color: 'text.secondary', mb: 2 }} />
                  <Typography variant="h6" color="text.secondary">Keine Mitglieder</Typography>
                  <Typography variant="body2" color="text.secondary">
                    Dieses Komitee hat noch keine Mitglieder.
                  </Typography>
                </Box>
              )}
            </Box>
          </TabPanel>
        </DialogContent>
        
        <DialogActions>
          <Button onClick={handleDetailsClose}>Schließen</Button>
          {selectedCommittee && !selectedCommittee.members?.some(m => m.id === user?.id) && (
            <Button 
              variant="contained" 
              startIcon={<PersonAddIcon />}
              onClick={() => {
                handleDetailsClose();
                handleJoinCommittee(selectedCommittee);
              }}
            >
              Beitreten
            </Button>
          )}
        </DialogActions>
      </Dialog>

      {/* Join Request Dialog */}
      <Dialog open={joinRequestDialog} onClose={() => setJoinRequestDialog(false)} maxWidth="sm" fullWidth>
        <DialogTitle>Beitrittsanfrage senden</DialogTitle>
        <DialogContent>
          {selectedItem && (
            <Box>
              <Typography variant="h6" gutterBottom>
                {selectedItem.name}
              </Typography>
              <Typography variant="body2" color="text.secondary" paragraph>
                Dieses Komitee ist geschlossen. Sende eine Beitrittsanfrage an die Komiteeleitung.
              </Typography>
              <TextField
                fullWidth
                label="Nachricht (optional)"
                multiline
                rows={4}
                value={joinRequestMessage}
                onChange={(e) => setJoinRequestMessage(e.target.value)}
                placeholder="Warum möchtest du diesem Komitee beitreten?"
                sx={{ mt: 2 }}
              />
            </Box>
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setJoinRequestDialog(false)}>Abbrechen</Button>
          <Button variant="contained" onClick={handleJoinRequest}>
            Anfrage senden
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}

export default CommitteesProjects;
