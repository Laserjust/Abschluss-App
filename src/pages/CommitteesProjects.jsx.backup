    {
      id: 'survey2',
      title: 'Cover-Design Wahl',
      description: 'Auswahl des Jahrbuch-Covers',
      committee: 'Jahrbuch-Komitee',
      expiresAt: new Date(currentYear, 4, 5),
      createdAt: new Date(currentYear, 3, 1),
      isActive: true,
      type: 'single',
      responses: 12,
