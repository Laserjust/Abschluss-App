      tasks: [
        { id: 1, title: 'Thema festlegen', completed: true },
        { id: 2, title: 'Materialien auflisten', completed: true },
        { id: 3, title: 'Budget kalkulieren', completed: false },
        { id: 4, title: 'Materialien beschaffen', completed: false }
      ],
      files: []
