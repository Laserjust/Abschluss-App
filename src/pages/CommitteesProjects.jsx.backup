  ];

  const mockSurveys = [
    {
      id: 'survey1',
      title: 'Motto-Abstimmung',
      description: 'Abstimmung über das Motto der Abschlussfeier',
      committee: 'Abschlussfeier-Komitee',
      expiresAt: new Date(currentYear, 3, 20),
      createdAt: new Date(currentYear, 2, 10),
      isActive: true,
      type: 'single',
      responses: 18,
      options: ['Gemeinsam ans Ziel', 'Endlich geschafft', 'Neue Wege'],
